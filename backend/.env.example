# ============================================================
#  StockIT — Environment Variables Template (SAFE TO COMMIT)
#  ⚠️  COPY THIS TO `.env` AND FILL IN YOUR OWN VALUES.
#  ⚠️  NEVER COMMIT THE REAL `.env` FILE WITH LIVE CREDENTIALS.
# ============================================================

# ------ Database ------------------------------------------------------------
# Supabase (PostgreSQL) — recommended for production
DATABASE_URL=postgresql://postgres.YOUR_SUPABASE_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# OR — local SQLite fallback (no setup needed, good for dev)
# DATABASE_URL=sqlite:///./stockit.db

# ------ JWT Auth ------------------------------------------------------------
# Generate a new one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_strong_64_hex_char_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------ AI Models -----------------------------------------------------------
YOLO_MODEL_PATH=models_ai/best.pt

# ------ LLM Provider — CHOOSE ONE -----------------------------------------
# Option A : Azure AI Foundry (managed Llama 3.3 / GPTs)
LLM_PROVIDER=azure
AZURE_AI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_AI_API_KEY=YOUR_AZURE_API_KEY
AZURE_CV_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_LLM_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1

# Option B : Ollama (fully local, free)
# LLM_PROVIDER=ollama
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ------ File Storage --------------------------------------------------------
UPLOAD_DIR=uploads

# ------ Application ---------------------------------------------------------
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,exp://192.168.*
