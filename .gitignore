# ============================================================
#  StockIT — Root .gitignore (Monorepo: Python/FastAPI + Expo RN)
# ============================================================
#  Note: backend/ and mobile/ each have their own .gitignore.
#  This file adds shared, cross-cutting, and root-level rules.
# ============================================================

# ------------------------------------------------------------
#  1. SECRETS — NEVER commit credentials / API keys
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
secrets.json
credentials.json
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision

# Old-school env / shell exports
.export-env.sh
secrets/

# ------------------------------------------------------------
#  2. OPERATING SYSTEM — Windows / macOS / Linux trash
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
*~
.directory

# ------------------------------------------------------------
#  3. EDITORS / IDEs — VS Code / JetBrains / Trae / Vim etc.
# ------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history

# JetBrains (PyCharm / WebStorm / IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Trae IDE
.trae/

# Sublime
*.sublime-workspace
*.sublime-project

# Vim / Neovim
*.swp
*.swo
*~
Session.vim

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ------------------------------------------------------------
#  4. PYTHON / FASTAPI (also covered by backend/.gitignore)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
build/
dist/
.Python
.tox/
.nox/
coverage/
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
pytype/
.pyre/
*.db
*.sqlite3
.db-journal
venv/
.venv/
env/
ENV/
.Python-version

# ------------------------------------------------------------
#  5. JAVASCRIPT / EXPO / REACT NATIVE
#     (also covered by mobile/.gitignore)
# ------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.pnp.js

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
*.orig.*

# React Native generated folders
/android
/ios
/ios-bak
/android-bak
/macos
/windows

# Metro bundler
.metro-health-check*
.metro/

# NPM / Yarn / PNPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------
#  6. AI MODEL CHECKPOINTS / DATA / UPLOADS
# ------------------------------------------------------------
# YOLO / PyTorch / HuggingFace large model weights
*.pt
*.pth
*.safetensors
*.ckpt
*.bin
.cache/
huggingface/

# ------------------------------------------------------------
#  7. LOGS + TEMPORARY / RUNTIME OUTPUTS
# ------------------------------------------------------------
*.log
logs/
log/
tmp/
temp/
*.tmp
*.bak
*.old
run/
pid/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------
#  8. ROOT-PROJECT ONLY (rules that only make sense at top)
# ------------------------------------------------------------
# Files used only for local scripting / scratch space
scratch/
sandbox/
playground/
local_tests/
backups/
backup/
dump.rdb
